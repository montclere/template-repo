{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git branch *)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(git commit --amend *)"
    ]
  }
}
